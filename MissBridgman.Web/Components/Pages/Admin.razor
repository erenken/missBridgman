@page "/admin"
@inject IHttpContextAccessor Context
@inject NavigationManager Navigation
@using MissBridgman.Web.Data
@inject TicketSettingsStore TicketSettings
<PageTitle>Photo admin | Miss Bridgman</PageTitle>
<section class="page-hero page-hero-compact"><p class="eyebrow">Site administration</p><h1>Manage gallery photos</h1><p>Add a photo with the context visitors need. Images appear in the public gallery as soon as they are uploaded.</p></section>
<section class="admin-shell section-wrap">
    @if (!authenticated)
    {
        <form class="interest-form admin-card" method="post" action="/api/admin/login">
            <p class="eyebrow">Administrator sign in</p><h2>Welcome back.</h2>
            @if (Navigation.ToAbsoluteUri(Navigation.Uri).Query.Contains("error=1")) { <p class="error-note">The password could not be verified.</p> }
            <label>Admin password<input name="password" type="password" required autocomplete="current-password" /></label>
            <button class="button button-dark" type="submit">Sign in <span>→</span></button>
        </form>
    }
    else
    {
        @if (Navigation.ToAbsoluteUri(Navigation.Uri).Query.Contains("uploaded=1")) { <p class="success-note">Photo uploaded and added to the gallery.</p> }
        @if (Navigation.ToAbsoluteUri(Navigation.Uri).Query.Contains("pricingUpdated=1")) { <p class="success-note">Form prices updated.</p> }
        @if (Navigation.ToAbsoluteUri(Navigation.Uri).Query.Contains("pricingError=1")) { <p class="error-note">Prices must be between $0 and $100,000. Check each amount and try again.</p> }
        @if (Navigation.ToAbsoluteUri(Navigation.Uri).Query.Contains("ticketPriceError=1")) { <p class="error-note">Prices could not be saved. Check the amounts and storage configuration.</p> }
        <form class="interest-form admin-card ticket-price-form" method="post" action="/api/admin/pricing">
            <p class="eyebrow">Form pricing</p><h2>Set form prices</h2>
            <p>These prices are saved in Azure Blob Storage and used on the ticket, Good Luck ad, and business ad forms. Enter 0 for a free item.</p>
            <h3>Ticket orders</h3><label>Price per ticket<input name="ticketPrice" type="number" min="0" max="100000" step="0.01" value="@pricing.TicketPrice.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)" required /></label>
            <h3>Good Luck ads</h3><div class="field-row"><label>Current version price per message<input name="goodLuckPrice" type="number" min="0" max="100000" step="0.01" value="@pricing.GoodLuckPrice.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)" required /></label><label>Archived version price per message<input name="archivedGoodLuckPrice" type="number" min="0" max="100000" step="0.01" value="@pricing.ArchivedGoodLuckPrice.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)" required /></label></div>
            <h3>Business ad sales</h3><div class="field-row"><label>Full page ad<input name="fullPageAdPrice" type="number" min="0" max="100000" step="0.01" value="@pricing.FullPageAdPrice.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)" required /></label><label>Half page ad<input name="halfPageAdPrice" type="number" min="0" max="100000" step="0.01" value="@pricing.HalfPageAdPrice.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)" required /></label></div><div class="field-row"><label>Quarter page ad<input name="quarterPageAdPrice" type="number" min="0" max="100000" step="0.01" value="@pricing.QuarterPageAdPrice.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)" required /></label><label>Business card ad<input name="businessCardAdPrice" type="number" min="0" max="100000" step="0.01" value="@pricing.BusinessCardAdPrice.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)" required /></label></div>
            <h3>Contact and form submissions</h3><label>Committee email address<input name="contactEmail" type="email" maxlength="254" value="@pricing.ContactEmail" required /></label>
            <button class="button button-dark" type="submit">Save form prices</button>
        </form>
        <div class="admin-heading"><div><p class="eyebrow">Gallery manager</p><h2>Add a photo</h2></div><form method="post" action="/api/admin/logout"><button class="button button-outline" type="submit">Sign out</button></form></div>
        <form class="interest-form admin-card" method="post" action="/api/admin/photos" enctype="multipart/form-data">
            <label>Photo file *<input type="file" name="image" accept="image/jpeg,image/png,image/webp" required /><small>JPG, PNG, or WebP. Maximum size 12 MB.</small></label>
            <div class="field-row"><label>Person or group name *<input name="name" maxlength="120" required /></label><label>Year *<input name="year" inputmode="numeric" pattern="[0-9]{4}" maxlength="4" required /></label></div>
            <label>Title / role<input name="title" maxlength="120" placeholder="Miss Bridgman, Mr. Bridgman, volunteers…" /></label>
            <label>Category<input name="category" maxlength="80" placeholder="Court, community service, event…" /></label>
            <label>Description<textarea name="description" rows="4" maxlength="500"></textarea></label>
            <button class="button button-dark" type="submit">Upload photo <span>→</span></button>
        </form>
    }
</section>
@code {
    private bool authenticated;
    private PricingSettings pricing = TicketSettingsStore.Defaults;
    protected override async Task OnInitializedAsync()
    {
        authenticated = Context.HttpContext?.User.Identity?.IsAuthenticated == true;
        if (authenticated)
        {
            try { pricing = await TicketSettings.GetSettingsAsync(); }
            catch (Azure.RequestFailedException) { }
        }
    }
}
