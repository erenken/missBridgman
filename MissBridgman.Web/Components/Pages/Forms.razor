@page "/forms"
@inject IJSRuntime JS
@inject IWebHostEnvironment Host
@using MissBridgman.Web.Data
@inject TicketSettingsStore TicketSettings
<PageTitle>Forms &amp; information | Miss Bridgman</PageTitle>
<section class="page-hero page-hero-compact screen-only"><p class="eyebrow">Your next step</p><h1>Forms &amp; information</h1><p>Complete the form online, then save or print a PDF copy. Select the form that matches your event.</p></section>
<section class="forms-shell section-wrap">
    <div class="form-picker screen-only"><label for="form-kind">Choose a form</label><select id="form-kind" @bind="selectedForm"><optgroup label="Contestant documents"><option value="interest">Participation interest</option><option value="application">Official application packet</option></optgroup><optgroup label="Fundraising forms"><option value="business">Business ad sales sheet</option><option value="luck15">Good Luck ad sale</option><option value="luck10">Good Luck ad sale (archived version)</option></optgroup><optgroup label="Ticket orders"><option value="ticketsMissMr">Miss / Mr ticket order</option><option value="ticketsLittles">Littles / Jr Teen / Teen ticket order</option></optgroup></select><p>The season’s event date and year can be entered on the forms where needed. All displayed prices are set by an administrator and may change each year. The archived Good Luck form uses the archived rate configured by the committee.</p></div>

    @if (selectedForm == "interest")
    {
        <form class="print-form">
            <h2>Participation interest</h2><p>Fields marked * are required. Complete the form here, save a PDF, and email it to the committee. The site does not retain form submissions.</p>
            <div class="field-row"><label>Participant name *<input @bind="interest.Name" required maxlength="120" /></label><label>Age *<input @bind="interest.Age" type="number" min="6" max="19" required /></label></div>
            <div class="field-row"><label>Parent or guardian name<input @bind="interest.Guardian" maxlength="120" /></label><label>Email address *<input @bind="interest.Email" type="email" maxlength="200" required /></label></div>
            <label>What would you like to know?<textarea @bind="interest.Notes" rows="4" maxlength="1200"></textarea></label>
        </form>
    }
    else if (selectedForm == "application")
    {
        <form class="print-form official-application">
            <header class="print-heading"><p class="eyebrow">Blossomtime Festival</p><h2>Official Application and Release Form</h2><div class="field-row"><label>Competition year<input @bind="application.Year" /></label><label>Competition type<select @bind="application.Type" @bind:after="LoadRegulationsAsync"><option>Queen</option><option>King</option></select></label></div></header>
            <section class="print-section"><h3>Contestant information</h3>
                <label>Contestant name<input @bind="application.Name" /></label><label>Address (street, not a P.O. Box)<input @bind="application.Address" /></label><div class="field-row three"><label>City<input @bind="application.City" /></label><label>State<input @bind="application.State" /></label><label>ZIP<input @bind="application.Zip" /></label></div>
                <div class="field-row"><label>Contestant cell number<input @bind="application.Cell" /></label><label>Email<input @bind="application.Email" type="email" /></label></div><div class="field-row"><label>High school attended and dates<input @bind="application.School" /></label><label>Grade<input @bind="application.Grade" /></label></div><div class="field-row four"><label>Sex<input @bind="application.Sex" /></label><label>Age<input @bind="application.Age" /></label><label>Date of birth<input @bind="application.BirthDate" type="text" placeholder="MM/DD/YYYY" /></label><label>T-shirt size<input @bind="application.ShirtSize" /></label></div>
                <h4>Mother / guardian</h4><div class="field-row"><label>Name<input @bind="application.MotherName" /></label><label>Cell number<input @bind="application.MotherCell" /></label></div><label>Street address<input @bind="application.MotherAddress" /></label><div class="field-row three"><label>City<input @bind="application.MotherCity" /></label><label>State<input @bind="application.MotherState" /></label><label>ZIP<input @bind="application.MotherZip" /></label></div><label>Email<input @bind="application.MotherEmail" type="email" /></label>
                <h4>Father / guardian</h4><div class="field-row"><label>Name<input @bind="application.FatherName" /></label><label>Cell number<input @bind="application.FatherCell" /></label></div><label>Street address<input @bind="application.FatherAddress" /></label><div class="field-row three"><label>City<input @bind="application.FatherCity" /></label><label>State<input @bind="application.FatherState" /></label><label>ZIP<input @bind="application.FatherZip" /></label></div><label>Email<input @bind="application.FatherEmail" type="email" /></label>
                <div class="field-row three"><label>Community name<input @bind="application.Community" /></label><label>CVT code<input @bind="application.CvtCode" /></label><label>School district code<input @bind="application.DistrictCode" /></label></div>
            </section>
            <section class="print-section regulations-section"><h3>Official regulations and application representations</h3><p>Please read all rules below. Contestant and parent / guardian must initial each page.</p>
                @foreach (var regulation in regulations) { var index = regulation.Number - 2; <article class="regulation-page"><pre>@regulation.Content</pre><div class="field-row initials-row"><strong>Page @regulation.Number initials</strong><label>Contestant initials<input @bind="application.PageInitials[index].Contestant" /></label><label>Parent / guardian initials<input @bind="application.PageInitials[index].Guardian" /></label></div></article> }
                <label class="check-line"><input type="checkbox" @bind="application.RulesAccepted" /> I have read and agree to the regulations and general rules in the official packet.</label>
            </section>
            <section class="print-section"><h3>Consent and hold harmless agreement</h3><p>By their signatures below, the applicant and @(application.Type == "King" ? "his" : "her") parent(s) or guardian(s) certify: 1) they have read and understand the rules and regulations as set forth in this document; 2) the applicant meets the requirements and will comply with the regulations stated; 3) they understand that untrue statements, misrepresentations, or failure to comply may result in the applicant’s disqualification and/or forfeiture of any Blossomtime Festival title; 4) we hereby release to the Blossomtime Festival the applicant’s records at any high school attended by her; 5) we do hereby release, unconditionally, and forever, any claim against the Blossomtime Festival, its officers, directors, agents, employees and corporate sponsors, and agree to hold them harmless as to any claim arising out of any participation in the Blossomtime Festival or its activities.</p>
                <div class="field-row signature-row"><SignaturePad @bind-Value="application.ApplicantSignature" Label="Applicant signature" /><label>Date<input @bind="application.ApplicantSignatureDate" type="text" placeholder="MM/DD/YYYY" /></label></div><div class="field-row signature-row"><SignaturePad @bind-Value="application.GuardianSignature" Label="Parent(s) / guardian(s) signature" /><label>Date<input @bind="application.GuardianSignatureDate" type="text" placeholder="MM/DD/YYYY" /></label></div>
                <h4>Certification of entry and endorsement</h4><p>This certifies that, to the best of the community representative’s knowledge, the contestant meets the stated regulations and entry requirements.</p><label>Community name<input @bind="application.EndorsementCommunity" /></label><div class="field-row signature-row"><SignaturePad @bind-Value="application.RepresentativeSignature" Label="Community representative signature" /><label>Title<input @bind="application.RepresentativeTitle" /></label><label>Date<input @bind="application.RepresentativeDate" type="text" placeholder="MM/DD/YYYY" /></label></div>
            </section>
            <section class="print-section"><h3>Blossomtime Cell Phone/Photo Release Policy</h3><p>The Blossomtime Organization has a very strict policy on cell phone usage during rehearsals and on Pageant Day. The following policy is to be observed by all Contestants.</p><p>1. Cell phone usage is prohibited at all practices and rehearsals. Only one warning will be given. Should a situation arise that requires a contestant to use their phone, they must first obtain permission from the Pageant Chairperson prior to use. Phones will be brought to practices or rehearsals and collected by the committee. They will be returned at the end of practice.</p><p>2. On Pageant Day, all contestants must turn in their cell phones to the appointed Committee Volunteer when signing in for the day. No exceptions. All phones will be labeled and locked up for safe-keeping and will only be released upon a contestant’s signing-out or in the event of an emergency.</p><p>3. Contestants further understand that their bags and other belongings may be subject to search for cell phones or other communication devices, with the contestant present, at any time on Pageant Day.</p><p>4. I, the undersigned, do hereby consent and agree that the Blossomtime Festival, Inc., its employees, or agents have the right to take photographs, videotape, or digital recordings of:</p><label>Name for photo release<input @bind="application.PhotoReleaseName" /></label><p>and to use these in any and all media, now or hereafter known, and exclusively for the purpose of promotion of the Blossomtime Festival, Inc. I further consent that my name and identity may be revealed therein or by descriptive text or commentary.</p><p>5. I do hereby release to the Blossomtime Festival, Inc., its agents, and employees all rights to exhibit this work in print and electronic form publicly or privately and to market and sell copies. I waive any rights, claims, or interest I may have to control the use of my identity or likeness in whatever media used.</p><p>6. I understand that there will be no financial or other remuneration for recording me, either for initial or subsequent transmission or playback.</p><p>7. I also understand that neither the Blossomtime Festival, Inc. are responsible for any expense or liability incurred as a result of my participation in this recording, including medical expenses due to any sickness or injury incurred as a result.</p><p>8. I represent that I am at least 18 years of age or am the legal guardian:</p><label>Legal guardian name (if applicable)<input @bind="application.ReleaseGuardianName" /></label><p>and have read and understand the foregoing statement, and am competent to execute this agreement.</p><p>9. I understand that by not complying with this policy I am at risk of becoming ineligible before and after the Pageant. I understand that in order to compete in any Blossomtime Pageant, I must agree to, sign, and return this form to the Chairperson by:</p><label>Return form to chairperson by<input @bind="application.ReleaseDueDate" /></label><div class="field-row signature-row"><SignaturePad @bind-Value="application.PhotoSignature" Label="Contestant signature" /><label>Date<input @bind="application.PhotoDate" type="text" placeholder="MM/DD/YYYY" /></label></div><div class="field-row signature-row"><SignaturePad @bind-Value="application.PhotoGuardianSignature" Label="Parent or legal guardian signature" /><label>Date<input @bind="application.PhotoGuardianDate" type="text" placeholder="MM/DD/YYYY" /></label></div><div class="field-row signature-row"><SignaturePad @bind-Value="application.PhotoChairSignature" Label="Chairperson signature" /><label>Date<input @bind="application.PhotoChairDate" type="text" placeholder="MM/DD/YYYY" /></label></div></section>
            <section class="print-section"><h3>Blossomtime Festival, Inc. — Social Network Release Form</h3><p>Contestant name, email, and cell number are listed in Contestant information above.</p><label>Community<input @bind="application.SocialCommunity" /></label><div class="field-row"><label>Instagram account name<input @bind="application.Instagram" /></label><label>Facebook account name<input @bind="application.Facebook" /></label></div><div class="field-row"><label>Snapchat name<input @bind="application.Snapchat" /></label><label>Twitter account name<input @bind="application.Twitter" /></label><label>TikTok<input @bind="application.TikTok" /></label></div><p>Parent / guardian names, email addresses, and cell numbers are listed in Contestant information above.</p><h4>Parent / guardian home phone</h4><div class="field-row"><label>Father / guardian home phone<input @bind="application.SocialFatherHome" /></label><label>Mother / guardian home phone<input @bind="application.SocialMotherHome" /></label></div><p>I agree to the guidelines set forth by the Blossomtime Festival regarding any and all social media. I will permit Blossomtime and its agent’s access to these accounts at all times during my participation with the Blossomtime Festival. Further, I agree to abstain from the use of foul language, any posts that may be deemed as bullying, or engage in any inappropriate comments, tweets, or posts. Violation of this policy will result in immediate dismissal.</p><div class="field-row signature-row"><SignaturePad @bind-Value="application.SocialContestantSignature" Label="Contestant signature" /><label>Date<input @bind="application.SocialContestantDate" type="text" placeholder="MM/DD/YYYY" /></label></div><div class="field-row signature-row"><SignaturePad @bind-Value="application.SocialGuardianSignature" Label="Parental / guardian signature" /><label>Date<input @bind="application.SocialGuardianDate" type="text" placeholder="MM/DD/YYYY" /></label></div></section>
            <section class="print-section"><h3>Medical and emergency information</h3><div class="field-row"><label>Currently under a physician’s care?<select @bind="application.UnderPhysicianCare"><option value="">Select</option><option>Yes</option><option>No</option></select></label><label>If yes, list reason<textarea @bind="application.PhysicianCareReason" rows="2"></textarea></label></div><div class="field-row"><label>Take medication daily?<select @bind="application.TakesMedication"><option value="">Select</option><option>Yes</option><option>No</option></select></label><label>If yes, list medications<textarea @bind="application.Medications" rows="2"></textarea></label></div><div class="field-row"><label>Food allergies or special dietary needs?<select @bind="application.FoodAllergies"><option value="">Select</option><option>Yes</option><option>No</option></select></label><label>Allergic to any medications?<select @bind="application.MedicationAllergies"><option value="">Select</option><option>Yes</option><option>No</option></select></label></div><label>If yes, list medication allergies<textarea @bind="application.AllergyDetails" rows="2"></textarea></label><label>Any medical issue we should be aware of?<textarea @bind="application.MedicalDetails" rows="2"></textarea></label><div class="field-row"><label>Health insurance company<input @bind="application.InsuranceCompany" /></label><label>Group number<input @bind="application.InsuranceGroup" /></label></div><div class="field-row"><label>Physician name<input @bind="application.Physician" /></label><label>Phone<input @bind="application.PhysicianPhone" /></label></div><div class="field-row"><label>Physician street<input @bind="application.PhysicianStreet" /></label><label>City<input @bind="application.PhysicianCity" /></label><label>State<input @bind="application.PhysicianState" /></label><label>ZIP<input @bind="application.PhysicianZip" /></label></div><div class="field-row"><label>Dentist name<input @bind="application.Dentist" /></label><label>Phone<input @bind="application.DentistPhone" /></label></div><div class="field-row"><label>Dentist street<input @bind="application.DentistStreet" /></label><label>City<input @bind="application.DentistCity" /></label><label>State<input @bind="application.DentistState" /></label><label>ZIP<input @bind="application.DentistZip" /></label></div>
                <h4>Consent for medical / dental / surgical treatment</h4><label>Name of patient<input @bind="application.PatientName" /></label><p>Minor. Permission is hereby given to this hospital, its physicians and its nursing staff to administer any treatment, diagnostic, therapeutic, or to administer such surgical procedures as may be deemed necessary or advisable in the diagnosis and treatment as condition warrants, and to release information as may be necessary for hospital claims.</p><div class="field-row signature-row"><SignaturePad @bind-Value="application.MedicalGuardianSignature" Label="Parent / legal guardian signature" /><SignaturePad @bind-Value="application.WitnessSignature" Label="Witness signature" /></div><div class="field-row"><label>Relationship to patient<input @bind="application.Relationship" /></label><label>Date<input @bind="application.MedicalDate" type="text" placeholder="MM/DD/YYYY" /></label></div>
                <h4>Contestant and guardian contact details</h4><p>Contestant and parent / guardian names, addresses, email addresses, and cell numbers are listed in Contestant information above.</p><div class="field-row"><label>Mother / guardian work phone<input @bind="application.ContactMotherWork" /></label><label>Mother / guardian home phone<input @bind="application.ContactMotherHome" /></label></div><div class="field-row"><label>Father / guardian work phone<input @bind="application.ContactFatherWork" /></label><label>Father / guardian home phone<input @bind="application.ContactFatherHome" /></label></div>
            </section>
        </form>
    }
    else if (selectedForm == "business")
    {
        <form class="print-form"><h2>Business ad sales sheet</h2><p>Miss / Mr. Littles, Jr. Teen and Teen Bridgman</p><div class="field-row"><label>Contestant name<input @bind="business.Contestant" /></label><label>Contestant phone<input @bind="business.ContestantPhone" /></label></div><label>Contestant email<input @bind="business.ContestantEmail" type="email" /></label><div class="field-row"><label>Business name<input @bind="business.BusinessName" /></label><label>Contact person<input @bind="business.Contact" /></label></div><label>Phone number<input @bind="business.Phone" /></label><fieldset><legend>Select one ad size or sponsor donation</legend>@foreach (var choice in AdChoices) { <label class="check-line"><input type="radio" name="adsize" value="@choice.Name" checked="@(business.AdChoice == choice.Name)" @onchange="_ => business.AdChoice = choice.Name" /> @choice.Label</label> }<label>Donation amount<input @bind="business.Donation" type="number" min="0" step=".01" /></label></fieldset><fieldset><legend>Image</legend><label class="check-line"><input type="radio" name="image" value="Attached" checked="@(business.ImageDelivery == "Attached")" @onchange='() => business.ImageDelivery = "Attached"' /> Attached</label><label class="check-line"><input type="radio" name="image" value="Will send via email" checked="@(business.ImageDelivery == "Will send via email")" @onchange='() => business.ImageDelivery = "Will send via email"' /> Will send via email to @pricing.ContactEmail</label></fieldset><p>Photo ads must be submitted in JPEG format.</p><label>Ad text<textarea @bind="business.AdText" rows="4"></textarea></label><fieldset><legend>Payment type</legend><label class="check-line"><input type="radio" name="adpayment" value="Cash" checked="@(business.PaymentType == "Cash")" @onchange='() => business.PaymentType = "Cash"' /> Cash</label><label class="check-line"><input type="radio" name="adpayment" value="Check" checked="@(business.PaymentType == "Check")" @onchange='() => business.PaymentType = "Check"' /> Check</label><label>Check number<input @bind="business.CheckNumber" /></label></fieldset><fieldset><legend>Payment received</legend><label class="check-line"><input type="radio" name="received" value="In Person" checked="@(business.PaymentReceived == "In Person")" @onchange='() => business.PaymentReceived = "In Person"' /> In person</label><label class="check-line"><input type="radio" name="received" value="Will be mailed" checked="@(business.PaymentReceived == "Will be mailed")" @onchange='() => business.PaymentReceived = "Will be mailed"' /> Will be mailed to Miss Bridgman Scholarship Organization, 9981 Baldwin Rd, Bridgman, MI 49106</label></fieldset><h3>Receipt</h3><div class="field-row"><label>Date<input @bind="business.ReceiptDate" type="text" placeholder="MM/DD/YYYY" /></label><label>Amount ($)<input @bind="business.ReceiptAmount" type="number" step=".01" /></label></div><label>Amount written out (dollars)<input @bind="business.AmountWords" /></label><div class="field-row"><label>For<input value="Sales Ad" readonly /></label><label>Given by (contestant name)<input @bind="business.GivenBy" /></label></div><fieldset><legend>Receipt payment method</legend>@foreach (var method in receiptMethods) { <label class="check-line"><input type="checkbox" @bind="business.ReceiptMethods[method]" /> @method</label> }</fieldset></form>
    }
    else if (selectedForm == "luck15" || selectedForm == "luck10")
    {
        var rate = selectedForm == "luck15" ? pricing.GoodLuckPrice : pricing.ArchivedGoodLuckPrice;
        <form class="print-form"><h2>Good Luck ad sale</h2><p>Miss / Mr. Littles, Jr. Teen and Teen Bridgman · $@rate each</p><label>Contestant name<input @bind="goodLuck.Contestant" /></label><p>Approximately 1¾ × 1¾ inch squares. Please print legibly, use no more than 15 words, and avoid special characters or questionable language.</p>
            @for (var rowIndex = 0; rowIndex < 4; rowIndex++) { var i = rowIndex; <section class="luck-entry"><h3>Good Luck message @(i + 1)</h3><div class="field-row"><label>From<input @bind="goodLuck.Entries[i].From" /></label><label>Message (15 words maximum)<textarea @bind="goodLuck.Entries[i].Message" rows="2" maxlength="220"></textarea></label></div><div class="field-row"><label>Price<input value="$@Money(rate)" readonly /></label><label>Payment type<select @bind="goodLuck.Entries[i].PaymentType"><option value="">Select</option><option>Cash</option><option>Check</option></select></label><label>Check number<input @bind="goodLuck.Entries[i].CheckNumber" /></label></div></section> }
            <p>Miss Bridgman Scholarship Organization · <a href="mailto:@pricing.ContactEmail">@pricing.ContactEmail</a></p>
        </form>
    }
    else
    {
        var littles = selectedForm == "ticketsLittles";
        <form class="print-form ticket-form"><h2>@(littles ? "Littles, Jr. Teen and Teen" : "Miss / Mr.") Bridgman Pageant Ticket Order</h2><div class="field-row"><label>Event year<input @bind="tickets.Year" /></label><label>Event date / location<input @bind="tickets.Event" /></label></div><label>Contestant name<input @bind="tickets.Contestant" /></label><table><thead><tr><th>#</th><th>Buyer name</th><th>Number of tickets</th><th>Price each</th><th>Total</th></tr></thead><tbody>@for (var rowIndex = 0; rowIndex < 15; rowIndex++) { var i = rowIndex; <tr><td>@(i + 1)</td><td><input aria-label="Buyer name" @bind="tickets.Rows[i].Name" /></td><td><input aria-label="Number of tickets" type="number" min="0" @bind="tickets.Rows[i].Count" /></td><td>$@Money(TicketPrice)</td><td>$@Money(tickets.Rows[i].Count * TicketPrice)</td></tr> }</tbody></table><div class="field-row"><label>Total amount in ticket sales ($)<input value="@Money(TicketSales)" readonly /></label><label>Total amount of cash submitted ($)<input @bind="tickets.CashSubmitted" type="number" step=".01" /></label></div><div class="field-row"><label>Total amount on check ($)<input @bind="tickets.CheckSubmitted" type="number" step=".01" /></label><label>Check number<input @bind="tickets.CheckNumber" /></label></div><p>Make final check payable to Miss Bridgman Queens Committee. Please keep a copy for your records.</p></form>
    }

    <div class="actions form-actions screen-only"><button class="button button-dark" type="button" @onclick="Print">Save form as PDF</button><span class="privacy-note">Choose “Save as PDF” in the print window. Your entered fields and drawn signatures will be included. Then email the downloaded form to <a href="mailto:@pricing.ContactEmail">@pricing.ContactEmail</a>.</span></div>
</section>
@code {
    private string selectedForm = "interest";
    private List<RegulationPage> regulations = [];
    private PricingSettings pricing = TicketSettingsStore.Defaults;
    private readonly InterestModel interest = new();
    private readonly ApplicationModel application = new();
    private readonly BusinessModel business = new();
    private readonly GoodLuckModel goodLuck = new();
    private readonly TicketModel tickets = new();
    private sealed record AdOption(string Name, string Label);
    private IReadOnlyList<AdOption> AdChoices =>
    [
        new("Full page ad", $"Full page ad — {Price(pricing.FullPageAdPrice)} (8 × 10 in)"),
        new("Half page ad", $"Half page ad — {Price(pricing.HalfPageAdPrice)} (5 × 7 in)"),
        new("Quarter page ad", $"Quarter page ad — {Price(pricing.QuarterPageAdPrice)} (4 × 5 in)"),
        new("Business card", $"Business card — {Price(pricing.BusinessCardAdPrice)} (3 × 2 in)"),
        new("Sponsor support donation", "Sponsor support donation")
    ];
    private static readonly string[] receiptMethods = ["Cash", "Check", "Money Order"];
    private decimal TicketPrice => pricing.TicketPrice;
    private decimal TicketSales => tickets.Rows.Sum(row => row.Count * TicketPrice);
    private static string Money(decimal amount) => amount.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture);
    private static string Price(decimal amount) => amount.ToString("C2", System.Globalization.CultureInfo.GetCultureInfo("en-US"));
    private static string GetDefaultEventYear()
    {
        var today = DateTime.Today;
        return (today > new DateTime(today.Year, 9, 1) ? today.Year + 1 : today.Year).ToString();
    }
    private sealed record RegulationPage(int Number, string Content);
    protected override async Task OnInitializedAsync()
    {
        application.Year = tickets.Year = GetDefaultEventYear();
        await LoadRegulationsAsync();
        try { pricing = await TicketSettings.GetSettingsAsync(); }
        catch (Azure.RequestFailedException) { }
    }
    private async Task LoadRegulationsAsync()
    {
        var role = application.Type.Equals("King", StringComparison.OrdinalIgnoreCase) ? "king" : "queen";
        var pages = new List<RegulationPage>();
        for (var number = 2; number <= 5; number++)
        {
            var path = Path.Combine(Host.ContentRootPath, "LegalText", $"{role}-page-{number}.txt");
            if (File.Exists(path)) pages.Add(new(number, await File.ReadAllTextAsync(path)));
        }
        regulations = pages;
    }
    private async Task Print() { try { await JS.InvokeVoidAsync("window.print"); } catch (InvalidOperationException) { } }
    private sealed class InterestModel { public string Name { get; set; } = ""; public string Age { get; set; } = ""; public string Guardian { get; set; } = ""; public string Email { get; set; } = ""; public string Notes { get; set; } = ""; }
    private sealed class Initials { public string Contestant { get; set; } = ""; public string Guardian { get; set; } = ""; }
    private sealed class ApplicationModel
