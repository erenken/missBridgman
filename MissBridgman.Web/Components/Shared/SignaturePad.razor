@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="signature-field">
    <span id="@_labelId" class="signature-label">@Label</span>
    <canvas @ref="_canvas" class="signature-canvas" role="img" aria-labelledby="@_labelId" aria-label="Signature drawing area"></canvas>
    <div class="signature-controls screen-only">
        <small>Sign with your finger, stylus, or mouse.</small>
        <button type="button" class="signature-clear" @onclick="ClearAsync">Clear signature</button>
    </div>
</div>

@code {
    private readonly string _labelId = $"signature-label-{Guid.NewGuid():N}";
    private ElementReference _canvas;
    private IJSObjectReference? _module;
    private DotNetObjectReference<SignaturePad>? _dotNetReference;

    [Parameter, EditorRequired] public string Label { get; set; } = "Signature";
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public EventCallback<string> ValueChanged { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/signature-pad.js");
            _dotNetReference = DotNetObjectReference.Create(this);
            await _module.InvokeVoidAsync("initialize", _canvas, _dotNetReference, Value);
        }
        catch (JSException) { }
        catch (InvalidOperationException) { }
    }

    [JSInvokable]
    public async Task SignatureChanged(string value)
    {
        Value = value;
        await ValueChanged.InvokeAsync(value);
    }

    private async Task ClearAsync()
    {
        if (_module is not null && _dotNetReference is not null)
        {
            try { await _module.InvokeVoidAsync("clear", _canvas, _dotNetReference); }
            catch (JSException) { }
            catch (InvalidOperationException) { }
        }
    }

    public async ValueTask DisposeAsync()
    {
        _dotNetReference?.Dispose();
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("dispose", _canvas);
                await _module.DisposeAsync();
            }
            catch (JSException) { }
            catch (InvalidOperationException) { }
        }
    }
}
